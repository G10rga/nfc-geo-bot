# Google Places API key (Google Cloud Console → APIs → Places API)
GOOGLE_PLACES_API_KEY=your_places_api_key_here

# Google Sheet ID from the spreadsheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART/edit
GOOGLE_SHEET_ID=your_spreadsheet_id_here

# Worksheet tab name (bottom of the sheet, often Sheet1)
GOOGLE_SHEET_TAB=Sheet1

# OAuth Desktop client JSON (downloaded from Google Cloud Console)
GOOGLE_OAUTH_CREDENTIALS_FILE=credentials.json

# Saved login token (created automatically on first run — do not edit)
GOOGLE_OAUTH_TOKEN_FILE=token.json
